{
  "name": "fieldnotes-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "An editorial portfolio template with thoughtful motion, original artwork, and a static-first Next.js foundation.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "upload:batches": "node scripts/prepare-uploads.mjs",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "geist": "1.8.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
